{
  "name": "nixe",
  "version": "0.1.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:tauri": "ng serve --host=${TAURI_DEV_HOST:-localhost} --allowed-hosts=${TAURI_DEV_HOST:-localhost}",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "test": "vitest run && pnpm --filter nixe-extension test",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings --ignore-pattern \"src/testing/lint-probe/**\" --ignore-pattern \"e2e/lint/*.probe.ts\" && eslint --max-warnings 0 \"src/**/*.html\"",
    "lint:fix": "oxlint --fix --ignore-pattern \"src/testing/lint-probe/**\" --ignore-pattern \"e2e/lint/*.probe.ts\" && eslint --fix \"src/**/*.html\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "start:demo": "ng serve --configuration demo",
    "e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "check:temp-dirs": "node --test scripts/check-test-temp-dirs.test.mjs && node scripts/check-test-temp-dirs.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@gravionlabs/helix-desktop": "^22.10.0",
    "@gravionlabs/helix-ui": "^22.10.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "~2.13.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "foliate-js": "^1.0.1",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.17.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "^1.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.11"
  }
}
