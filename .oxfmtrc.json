{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": false,
  "associations": [
    {
      "files": ["src/app/**/*.html"],
      "language": "angular-html"
    }
  ],
  "ignorePatterns": [
    "dist",
    ".angular",
    "node_modules",
    "out-tsc",
    "coverage",
    "src-tauri",
    ".agents",
    ".claude",
    "docs",
    "fixtures",
    "*.md",
    "pnpm-lock.yaml",
    "skills-lock.json"
  ]
}
